#!/bin/sh
#
# audio-test [file.wav] -- configure the F1C100s codec and play a WAV.
#
# The target uses tinyalsa 1.1.1, whose tinymix syntax is:
#   tinymix contents
#   tinymix get  NAME
#   tinymix set  NAME VALUE...
#
set -u

wav="${1:-}"
if [ -z "$wav" ]; then
	for p in /mnt/sd/test-music.wav \
		 /mnt/sd/test-speech.wav \
		 /mnt/sd/test-tone.wav \
		 /usr/share/audio/test-tone.wav; do
		if [ -f "$p" ]; then
			wav="$p"
			break
		fi
	done
fi

if [ -z "$wav" ] || [ ! -f "$wav" ]; then
	echo "usage: audio-test /path/to/file.wav" >&2
	echo "missing: ${wav:-no default wav found}" >&2
	exit 1
fi

echo "== codec controls before =="
tinymix contents 2>/dev/null |
	grep -E 'Headphone|DAC|Speaker|Power Amplifier' || true

# suniv codec: DAC -> headphone amp, unmute both channels.
# Both volumes are 0 dB at their max value (63).
tinymix set "Headphone Source Playback Route" DAC 2>/dev/null || true
tinymix set "Headphone Playback Switch" 1 1 2>/dev/null || true
tinymix set "Headphone Playback Volume" 63 2>/dev/null || true
tinymix set "DAC Playback Volume" 55 2>/dev/null || true
# In case a previous silent-passage test left the PA powered down.
tinymix set "Headphone PA Enable" 1 2>/dev/null || true

echo "== codec controls after =="
tinymix contents 2>/dev/null |
	grep -E 'Headphone|DAC|Speaker|Power Amplifier' || true

echo "== PCM device =="
tinypcminfo -D 0 -d 0 2>/dev/null | head -20 || true

echo "== playing $wav =="
tinyplay -D 0 -d 0 "$wav"
rc=$?

# Leave the PA enabled for the next playback.
tinymix set "Headphone PA Enable" 1 2>/dev/null || true
exit $rc
