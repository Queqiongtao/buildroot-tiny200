#!/bin/sh
#
# sdcard-umount -- unmount /mnt/sd.
#
# Called from udev removal and from /etc/init.d/S99sdcard stop.
# A normal umount flushes the FAT state; if a player still holds a
# file open, fall back to a lazy detach so the card can be removed.
#
set -u

mnt=/mnt/sd
logger=/usr/bin/logger

log()
{
	[ -x "$logger" ] && "$logger" -t sdcard "$*" 2>/dev/null || true
}

if ! /bin/grep -q " $mnt " /proc/mounts; then
	exit 0
fi

if /bin/umount "$mnt" 2>/dev/null; then
	log "unmounted $mnt"
	exit 0
fi

/bin/sync
if /bin/umount -l "$mnt" 2>/dev/null; then
	log "lazily unmounted $mnt (busy)"
	exit 0
fi

log "umount $mnt failed"
exit 1
